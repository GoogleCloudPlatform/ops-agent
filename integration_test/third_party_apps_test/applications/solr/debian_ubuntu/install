set -e

sudo apt-get update
# Debian 12 very specifically wants openjdk-17-jdk for installing Java via apt
source /etc/os-release
if [[ $ID == debian && "${VERSION_ID}" == 12 ]]; then
    sudo apt-get install -y openjdk-17-jdk openjdk-17-jdk-headless curl lsof
else
    sudo apt-get install -y default-jdk default-jdk-headless curl lsof
fi

# https://github.com/GoogleCloudPlatform/ops-agent/blob/master/integration_test/README.md#vendored-dependencies
curl -L -o \
    solr-8.11.1.tgz \
    https://storage.googleapis.com/ops-agents-public-buckets-vendored-deps/mirrored-content/archive.apache.org/dist/lucene/solr/8.11.1/solr-8.11.1.tgz

tar -xzf \
    solr-8.11.1.tgz \
    solr-8.11.1/bin/install_solr_service.sh \
    --strip-components=2

sudo bash ./install_solr_service.sh solr-8.11.1.tgz -n

sudo chown -R solr:solr /opt/solr*

sudo sed -i '/ENABLE_REMOTE_JMX_OPTS/s/false/true/' /etc/default/solr.in.sh
sudo sed -i '/ENABLE_REMOTE_JMX_OPTS/s/^# *//' /etc/default/solr.in.sh

# systemd v260+ (e.g. Ubuntu 26.10) no longer generates units from SysV init
# scripts, so wrap /etc/init.d/solr in a native unit when the generator is gone.
if [[ ! -e /usr/lib/systemd/system-generators/systemd-sysv-generator && ! -e /lib/systemd/system-generators/systemd-sysv-generator ]]; then
  sudo tee /etc/systemd/system/solr.service > /dev/null << EOF
[Unit]
Description=Apache Solr (SysV init script wrapper)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
ExecStart=/etc/init.d/solr start
ExecStop=/etc/init.d/solr stop
RemainAfterExit=yes
GuessMainPID=no
KillMode=process
TimeoutSec=5min
SuccessExitStatus=5 6

[Install]
WantedBy=multi-user.target
EOF
fi

sudo systemctl daemon-reload
sudo systemctl enable solr
sudo systemctl restart solr

# Adding a core called otel so that there are some metrics to scrape
sudo su - solr -c "/opt/solr/bin/solr create -c otel"
